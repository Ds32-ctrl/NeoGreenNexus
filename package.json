{
  "name": "neogreennexus",
  "version": "2.0.0",
  "description": "Ecosistema Modular NeoGreenNexus (Web, Android APK & Nexus Core Desktop)",
  "main": "electron/main.js",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis --x64 --publish always && powershell -Command \"Remove-Item -Recurse -Force dist-desktop\"",
    "android:init": "npx cap add android",
    "android:sync": "npx cap copy android",
    "android:open": "npx cap open android",
    "android:build": "npx cap copy android && .\\android\\gradlew -p android assembleDebug && node scripts/upload-apk.js"  
    },
    "build": {
    "appId": "com.neogreennexus.desktop",
    "productName": "NexusCore",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "public/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NexusCore-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Ds32-ctrl",
      "repo": "NeoGreenNexus",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0"
  }
}
