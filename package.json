{
  "name": "neogreennexus",
  "version": "2.0.11",
  "description": "Ecosistema Modular NeoGreenNexus (Web, Android APK & Nexus Core Desktop)",
  "main": "electron/main.js",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis --x64 --publish onTag",
    "android:init": "npx cap add android",
    "android:sync": "npx cap copy android",
    "android:open": "npx cap open android",
    "android:build": "npx cap copy android && node -e \"const cp = require('child_process'); cp.execSync('.\\\\android\\\\gradlew -p android assembleDebug', {env: {...process.env, JAVA_HOME: 'C:\\\\Program Files\\\\Eclipse Adoptium\\\\jdk-21.0.13.9-hotspot'}, stdio: 'inherit'});\" && node scripts/upload-apk.js",
    "version:bump": "npm version patch -m \"chore(release): version %s\"",
    "version:sync": "node -e \"require('fs').writeFileSync('public/js/core/version.js', 'export const APP_VERSION = ' + JSON.stringify(require('./package.json').version) + ';')\"",
    "git:push": "git push --follow-tags",
    "deploy:all": "npm run version:bump && npm run version:sync && npm run git:push && npm run desktop:build && npm run android:build && firebase deploy --only hosting"
  },
  "build": {
    "appId": "com.neogreennexus.desktop",
    "productName": "NexusCore",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "public/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NexusCore-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Ds32-ctrl",
      "repo": "NeoGreenNexus",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0"
  }
}
