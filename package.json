{
  "name": "neogreennexus",
  "version": "2.0.0",
  "description": "Ecosistema Modular NeoGreenNexus (Web, Android APK & Nexus Core Desktop)",
  "main": "electron/main.js",
  "scripts": {
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.neogreennexus.desktop",
    "productName": "NexusCore",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "public/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NexusCore-Setup.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}